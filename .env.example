# =====================================================
# ai-conversioneditor — environment variables
# =====================================================

# --- Required ---
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
FILE_SIGNING_KEY=generate-with-openssl-rand-hex-32
MCP_AUTH_TOKEN=optional-but-recommended-bearer-token

# --- Storage (Railway Volume mount point) ---
DATA_DIR=/data
FILE_TTL_HOURS=24
CLEANUP_INTERVAL_MIN=60

# --- Worker pool (pre-warm light by default) ---
LO_WARM=2
LO_MAX=8
CHROMIUM_WARM=1
CHROMIUM_MAX=4

# --- LLM ---
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
LLM_MODEL_PRIMARY=moonshotai/Kimi-K2.6
LLM_MODEL_FALLBACK=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_S=120

# --- Public base URL (Railway provides RAILWAY_PUBLIC_DOMAIN automatically) ---
# PUBLIC_BASE_URL=https://ai-conversioneditor-production.up.railway.app

# --- Server ---
PORT=8000
