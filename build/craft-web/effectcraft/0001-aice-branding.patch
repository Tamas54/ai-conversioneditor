 pub fn specs() -> Vec<CommandSpec> {
+    let mut v = all_specs();
+    // AICE: the web build has no community or project links (Discord, getartcraft.com, GitHub docs and
+    // issues, other apps) — they are left out of the menus, the command search and the agent catalogue.
+    if cfg!(target_arch = "wasm32") {
+        v.retain(|c| matches!(c.id, "help.inAppTutorials"));
+    }
+    v
+}
+
+fn all_specs() -> Vec<CommandSpec> {
     vec![
         cmd!("help.docs", "EffectCraft Help...", [], Some("F1"), "{page?: help|scripting|expressions|effects|agents}", always, docs),
         cmd!("help.discord", "Join the ArtCraft Discord...", ["Help"], None, "{}", always, |s, _| open(s, links::DISCORD.into())),
