 #[cfg(target_arch = "wasm32")]
-fn try_load(_paths: &[(&str, u32)]) -> Option<FontData> {
-    None
+fn try_load(paths: &[(&str, u32)]) -> Option<FontData> {
+    // AICE: the web build has no system fonts. It embeds Carlito (metric-compatible with Calibri,
+    // Excel's default), so the cell roles that list it get real Calibri metrics instead of egui's
+    // default face. The files are fetched before the build into assets/fonts/ by the
+    // ai-conversioneditor build/craft-web/fetch-fonts.sh, SHA256-checked.
+    const CARLITO: &[(&str, &[u8])] = &[
+        ("/Carlito-Regular.ttf", include_bytes!("../../../assets/fonts/Carlito-Regular.ttf")),
+        ("/Carlito-Bold.ttf", include_bytes!("../../../assets/fonts/Carlito-Bold.ttf")),
+        ("/Carlito-Italic.ttf", include_bytes!("../../../assets/fonts/Carlito-Italic.ttf")),
+        ("/Carlito-BoldItalic.ttf", include_bytes!("../../../assets/fonts/Carlito-BoldItalic.ttf")),
+    ];
+    paths.iter().find_map(|(p, _)| CARLITO.iter().find(|(name, _)| p.ends_with(name)).map(|(_, bytes)| FontData::from_static(bytes)))
 }
 
